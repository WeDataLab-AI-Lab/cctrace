# Machine-local build values for a release.
#
# Copy this file to deploy/local-defaults.env and point it at your own server.
# The real file is gitignored, so each deployment keeps its own addresses out of
# the repository — a public build made without it simply prompts for both values.
#
# Read by both deploy/push.sh (bash) and the Makefile (make), so the syntax is
# limited to what both accept: KEY=value, no quotes, no `export`, no spaces
# around `=`.

# 배포 대상 서버. deploy/push.sh · deploy/reset.sh · scripts/fleet-query.sh 와
# local-web-dev 스킬이 모두 이 값을 쓴다.
#
# 예전에는 네 스크립트에 각각 박혀 있었다 -- 한 머신의 주소가 모두의 체크아웃에
# 들어가 있었고, 서버를 옮기면 네 곳을 찾아 고쳐야 했다. 기본값은 두지 않는다:
# 없으면 조용히 남의 서버로 향하는 대신 명확히 멈춘다.
#
# 원격 경로는 로그인 이름에서 유도한다 — 로그인 사용자의 홈 아래 projects 다.
# 레이아웃이 다르면 DEPLOY_REMOTE_BASE 로 덮어쓴다 -- 주소만 바꿀 수 있고 경로는
# 박혀 있으면 다른 서버로는 여전히 배포되지 않는다.
DEPLOY_HOST=deploy@cctrace.example.com
DEPLOY_REMOTE_BASE=

DEFAULT_SYNC_ENDPOINT=http://cctrace.example.com:8080
DEFAULT_OTEL_ENDPOINT=http://cctrace.example.com:4317

# `push.sh --env dev` 가 클라이언트에 박을 주소 (dev 전용).
#
# dev 이미지도 /downloads 로 클라이언트를 배포하는데, 여기가 비어 있으면 위의
# prod 주소가 그대로 박힌다 — dev 에서 받은 클라이언트가 init 에서 Enter 한 번에
# prod 로 향한다. dev 포트는 prod 포트에서 유도할 수 없으므로 명시해야 한다.
DEV_SYNC_ENDPOINT=
DEV_OTEL_ENDPOINT=

# dev-sync 후 이 계정을 admin 으로 승격 (dev 전용). 비우면 승격하지 않는다.
# email 이 아니라 cctrace_user_id 를 쓰는 이유: 이메일보다 안정적이고, 이메일 리터럴이 파일에 남지 않는다.
DEV_ADMIN_USER_ID=

# 업데이트 매니페스트에 서명할 Ed25519 개인 키 파일의 경로.
#
# 키 자체가 아니라 경로만 둔다 — 키는 저장소 바깥, 릴리스 머신에 0600 으로
# 보관한다(docs/guides/guide-deployment.md "개인 키 보관" 참조). 경로를 여기
# 두는 이유는 릴리스마다 셸에서 export 하는 것에 의존하지 않기 위해서다:
# 빠뜨리면 배포가 시작 직전에 멈춘다.
#
# 셸에서 UPDATE_SIGNING_KEY_FILE 을 명시적으로 export 하면 그 값이 이 파일보다
# 우선한다. 키 교체 중에는 머신 기본값이 아닌 키로 서명해야 하기 때문이다.
UPDATE_SIGNING_KEY_FILE=

# 주간 AI 리포트(CCTRACE_AI_RUNTIME_DEFAULT=codex-app-server)를 켜는 배포만 채운다.
#
# 값을 주면 cctraced 이미지에 그 버전의 codex CLI 가 들어간다(약 263MB 증가).
# deploy/Dockerfile 이 버전별 sha256 을 고정하므로 0.161.0 외의 버전은
# Dockerfile 의 digest 도 함께 바꿔야 빌드된다. 비우면 codex 없이 빌드한다.
CODEX_VERSION=
