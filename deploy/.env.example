# Set DB_PASSWORD before the first start: Postgres only applies it when the
# volume is initialised, and changing it later leaves the role's password at the
# old value while cctraced restart-loops on SQLSTATE 28P01.
DB_PASSWORD=change-me-strong-password

# The role cctraced connects as, as a single <user>:<password> pair.
#
# One variable rather than two on purpose: with a separate user and password,
# setting only one renders a URL pairing the bootstrap user with the application
# password. That fails to authenticate -- or, if the two passwords happen to
# match, silently keeps the superuser connection this is meant to remove.
#
# Leave it empty and the application connects as the bootstrap superuser, which
# is the state #26 describes: a flaw in the app then reaches
# `COPY ... FROM PROGRAM` and runs commands inside the database container.
#
# A NEW deployment gets the role from deploy/initdb/10-app-role.sh on first
# start, so set this before the first `docker compose up`.
# An EXISTING deployment needs scripts/migrate-db-app-role.sh first: the role
# has to own the objects the superuser already created, or the next boot
# migration fails with "must be owner".
#
#   DB_APP_CREDENTIALS=cctrace_app:some-strong-password
DB_APP_CREDENTIALS=
# Optional first-admin token; unset generates a token in server logs. Invalid after setup.
# CCTRACE_SETUP_TOKEN=
JWT_SECRET=change-me-at-least-32-bytes-long-secret-key

# Set to 1 behind HTTPS proxies to force Secure auth cookies even without
# X-Forwarded-Proto. Leave 0 for plain HTTP development.
COOKIE_SECURE=0

# Host path for the container logs. It has no default; leaving it empty stops
# the stack from starting.
LOGS_DIR=/data/logs-host-path

# Host publish addresses: Compose variables, not Go server environment variables.
# HTTP is loopback-only by default; use an HTTPS proxy for remote access.
# OTLP accepts collection from other machines, so 4317/4318 default to all
# interfaces. Restrict those ports with a firewall/VPN or set loopback below.
HTTP_BIND=127.0.0.1
GRPC_BIND=0.0.0.0
OTEL_HTTP_BIND=0.0.0.0

# Host-side ports. Left empty, each keeps the container's own number
# (8080 / 4317 / 4318; the DB is 5432 and binds to 127.0.0.1 only).
HTTP_PORT=8080
GRPC_PORT=4317
OTEL_HTTP_PORT=4318
DB_PORT=5432

# Retention in days. Unset means "leave the policy as it is", so a deploy never
# changes retention on its own. session_records holds conversation content and
# has no policy by default -- it is kept indefinitely until you set this.
# 0 states permanent retention explicitly.
# OTEL_RETENTION_DAYS=90
# SESSION_RETENTION_DAYS=90

# Container name prefix. Change it only to run a second stack on a host that
# already runs cctrace -- the default names would collide.
# CONTAINER_PREFIX=cctrace

# Local server image tags. Compose never pulls either service image.
# If changed, build with exactly the same tag -- a tag with no local image makes
# the stack fail to start rather than fall back to a registry.
#
# Two tags because the two images are built and sent independently: an app-only
# deploy leaves the database image alone. Tying the database to IMAGE_TAG would
# point compose at an image that deploy never sent.
IMAGE_TAG=latest
DB_IMAGE_TAG=latest
# Optional browser origins on a different host or port (comma-separated).
# Empty disables CORS. Use exact scheme://host[:port], without paths or wildcard.
# CCTRACE_ALLOWED_ORIGINS=https://dashboard.example.com,http://localhost:3000
CCTRACE_ALLOWED_ORIGINS=
# Ceiling in bytes for one POST /api/sync body. Default 8388608 (8 MiB),
# maximum 268435456 (256 MiB); anything larger or unparseable keeps the default.
# The client batches 200 records at a time and never splits by size, so a batch
# above the ceiling is rejected with 413 and its offset is not advanced: that
# file's sync stops there permanently. A single record larger than the ceiling
# cannot be split at all. Raise this if the deployment's own batches exceed it.
#
# Two costs come with a higher ceiling. The body is buffered whole and decoding
# roughly quintuples it, with no concurrency bound on this route, so budget
# about five times the ceiling per in-flight oversized request. And the server
# reads the whole body under a 30 s deadline while the client allows 30 s for
# the entire round trip, so a batch is only deliverable at roughly
# ceiling / 30 s sustained -- about 2.2 MB/s (18 Mbit/s) at 64 MiB. Clients on a
# slower uplink than that fail with a transport error and no HTTP status, which
# raising the ceiling does not fix.
# CCTRACE_MAX_SYNC_BODY_BYTES=67108864
CCTRACE_MAX_SYNC_BODY_BYTES=

# Weekly AI reports send work records to an outside provider only once turned
# on. Every variable below is a DEFAULT: what the server uses until an admin
# decides in Admin > AI, whose choice is stored in the database and wins from
# then on. Order: the admin's switch, else CCTRACE_AI_ENABLED_DEFAULT
# (true/false), else on when CCTRACE_AI_RUNTIME_DEFAULT is set, else off.
CCTRACE_AI_ENABLED_DEFAULT=
# Every runtime the server can run is built at boot and an admin picks one in
# Admin > AI; this is the default until then (codex-app-server, openai-api,
# claude-api, nvidia-api, litellm-api). Empty chooses none, so no report runs;
# no runtime is picked automatically. codex-app-server needs codex in the image
# (CODEX_VERSION in deploy/local-defaults.env).
CCTRACE_AI_RUNTIME_DEFAULT=
# Zone the weekly auto-generation time is read in for a user who saved no zone
# and has no report yet (IANA name). Compose passes Asia/Seoul when this is
# empty; an invalid name logs a warning and reads UTC.
CCTRACE_AI_DEFAULT_TZ=
# codex-app-server model and reasoning effort. Empty model runs gpt-5.6-terra;
# empty effort uses the model's default. A value an admin saves in Admin > AI
# overrides these, per runtime and item, from the next run on.
CCTRACE_AI_MODEL_DEFAULT=
CCTRACE_AI_REASONING_EFFORT_DEFAULT=
# openai-api and claude-api models. Empty runs gpt-5.6-terra / claude-sonnet-5.
CCTRACE_AI_OPENAI_MODEL_DEFAULT=
CCTRACE_AI_CLAUDE_MODEL_DEFAULT=
# nvidia-api model. Empty runs z-ai/glm-5.3, the NVIDIA model measured to
# honour both a forced tool call and json_schema output.
CCTRACE_AI_NVIDIA_MODEL_DEFAULT=
# litellm-api is self-hosted, so it has no address until one is given here or
# saved in Admin > AI, which wins. A trailing /v1 is accepted. The model is the
# proxy's own name for it, so there is no built-in default.
CCTRACE_AI_LITELLM_BASE_URL_DEFAULT=
CCTRACE_AI_LITELLM_MODEL_DEFAULT=
# API keys. While set, Admin > AI cannot change them; empty lets an admin
# register one there. OPENAI_API_KEY, ANTHROPIC_API_KEY and NVIDIA_API_KEY are
# not read -- only the CCTRACE_ prefixed names below.
CCTRACE_AI_OPENAI_API_KEY=
CCTRACE_AI_ANTHROPIC_API_KEY=
CCTRACE_AI_NVIDIA_API_KEY=
CCTRACE_AI_LITELLM_API_KEY=
# Encrypts keys registered in Admin > AI; at least 32 bytes. Empty uses
# JWT_SECRET, so rotating JWT_SECRET would make stored keys unreadable: set this
# instead. Changing the one in use means registering keys again.
CCTRACE_SECRETS_KEY=

# --- TLS termination (deploy/docker-compose.tls.yml, opt-in) ---
# Only read when that overlay is used. Set the three publish addresses above to
# 127.0.0.1 as well, or the plaintext ports stay reachable beside the TLS ones.
# CADDY_SITE_ADDRESS=cctrace.example.com   # required by the overlay: a hostname, or the server IP
# CADDY_TLS_MODE=internal                  # Caddy's own CA; `acme` for a publicly resolvable name
# TLS_BIND=0.0.0.0
# TLS_HTTP_PORT=8443
# TLS_GRPC_PORT=5317
# TLS_OTEL_HTTP_PORT=5318
